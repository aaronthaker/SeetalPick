# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_GITHUB_USERNAME.github.io/SeetalPick/

# Optional: enables film as well as TV lookups. TV lookup works without it.
NEXT_PUBLIC_TMDB_READ_TOKEN=

# Only used when Supabase is not configured (local preview mode).
NEXT_PUBLIC_DEMO_PASS_ONE=together
NEXT_PUBLIC_DEMO_PASS_TWO=always

# Set by the GitHub Pages workflow for project pages, e.g. /SeetalPick
NEXT_PUBLIC_BASE_PATH=
